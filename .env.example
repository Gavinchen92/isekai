# mock 只用于开发、测试和无 key 演示。真实游玩建议使用 openai-compatible。
GM_PROVIDER=mock

HOST=127.0.0.1
PORT=8787

# 接入 OpenAI-compatible provider 时取消下面几行注释。
# GM_PROVIDER=openai-compatible
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TEMPERATURE=0.7
# OPENAI_TIMEOUT_MS=60000
# OPENAI_PREVIEW_TEMPERATURE=1.0
# OPENAI_PREVIEW_THINKING=disabled

# 也可以使用 GM_OPENAI_* 覆盖同名配置。
# GM_OPENAI_API_KEY=
# GM_OPENAI_MODEL=
# GM_OPENAI_PREVIEW_TEMPERATURE=
# GM_OPENAI_PREVIEW_THINKING=

# 日志。默认开发环境写入 data/logs/api.jsonl；测试环境默认静默。
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE=data/logs/api.jsonl
LOG_LLM_PAYLOADS=false
LOG_PAYLOAD_MAX_CHARS=1200
